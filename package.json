    "configuration": {
      "title": "Pi",
      "properties": {
        "piRpc.piSource": {
          "type": "string",
          "enum": [
            "bundled",
            "inprocess",
            "managed",
            "external"
          ],
          "enumDescriptions": [
            "Run a vendored Pi when present (dev builds; the Marketplace VSIX no longer bundles Pi).",
            "Run a vendored Pi in-process on a worker thread (dev builds). Experimental.",
            "Bootstrap the LATEST Pi into the extension storage on first use and keep it updated (needs npm + network once).",
            "Run the `pi` on your PATH or the 'Pi: Executable' override."
          ],
          "default": "managed",
          "description": "Where to run the Pi agent from. 'managed' (default) auto-installs the latest Pi on first use and self-updates; 'external' uses your installed `pi`. Each falls back to external `pi` if unavailable."
        },
        "piRpc.autoInstall": {
          "type": "boolean",
          "default": false,
          "description": "Allow the extension to install (and self-update) Pi from npm when no `pi` is found on PATH. Off by default: an existing `pi` installation is always used as-is; without one, chats stay offline until you install Pi yourself or enable this."
        },
        "piRpc.runtimeWorkers": {
          "type": [
            "string",
            "number"
          ],
          "default": "auto",
          "description": "Size of the Pi runtime worker pool hosting parallel chats. 'auto' scales with your CPU (cores/4, capped at 4 — e.g. 3 workers on 14 cores); a number (1–8) pins it. More workers = more chats generating truly in parallel, at ~150MB memory each."
        },
        "piRpc.idleSessionMinutes": {
          "type": "number",
          "default": 15,
          "description": "Free a hidden chat's session after this many idle minutes (0 = never). The tab and transcript stay; the session restarts instantly when you focus the tab. Busy chats and chats waiting for approval are never touched."
        },
        "piRpc.turnReview": {
          "type": "boolean",
          "default": true,
          "description": "Snapshot the git tree when a Pi turn starts and offer a consolidated review (diff/revert) of every file the turn changed."
        },
        "piRpc.sharedRuntime": {
          "type": "boolean",
          "default": true,
          "description": "Run all chats on ONE shared Pi runtime (many sessions in a single host worker) instead of one process per chat. Big memory win for parallel chats. Falls back to a per-chat process automatically if the shared host can't start."
        },
        "piRpc.executable": {
          "type": "string",
          "default": "pi",
          "description": "Pi executable (used when Pi Source = external, or as a fallback if the bundled Pi is missing)."
        },
        "piRpc.additionalArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional non-secret Pi CLI arguments. --api-key is rejected."
        },
        "piRpc.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Start Pi automatically when a trusted file workspace is opened."
        },
        "piRpc.launchShell": {
          "type": "string",
          "default": "",
          "description": "Path to your shell executable, exported as PI_LAUNCH_SHELL so Pi's shell-inheritance extension can load. Required on Windows for that extension (e.g. C:\\Program Files\\Git\\bin\\bash.exe, powershell.exe, pwsh.exe, or cmd.exe). Empty auto-detects (defaults to cmd.exe on Windows)."
        },
        "piRpc.offline": {
          "type": "boolean",
          "default": false,
          "description": "Launch Pi with --offline. Off by default so Pi runs online like the TUI (some extensions need the network at startup). Enable only to force offline."
        },
        "piRpc.allowApproveInTrustedWorkspace": {
          "type": "boolean",
          "default": false,
          "description": "Allow --approve after explicit confirmation in trusted workspaces."
        },
        "piRpc.responseTimeoutMs": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "description": "Default RPC response timeout in milliseconds for short-lived commands."
        },
        "piRpc.longRunningTimeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "description": "Default RPC response timeout in milliseconds for long-running commands like bash and export."
        },
        "piRpc.maxRecordBytes": {
          "type": "number",
          "default": 67108864,
          "minimum": 1024,
          "description": "Maximum JSONL record size accepted from Pi stdout. Defaults to 64 MiB so older sessions with large images or tool outputs can resume."
        },
        "piRpc.maxPendingRequests": {
          "type": "number",
          "default": 256,
          "minimum": 1,
          "description": "Maximum in-flight correlated RPC requests per controller."
        },
        "piRpc.messageWindowSize": {
          "type": "number",
          "default": 50,
          "minimum": 10,
          "description": "How many recent messages to render when opening a chat. Older messages load on demand as you scroll up, keeping large sessions fast."
        },
        "piRpc.maxQueuedWrites": {
          "type": "number",
          "default": 256,
          "minimum": 1,
          "description": "Maximum queued outbound writes per controller."
        },
        "piRpc.maxTranscriptItems": {
          "type": "number",
          "default": 400,
          "minimum": 10,
          "description": "Maximum retained transcript items in the webview snapshot."
        },
        "piRpc.maxToolOutputChars": {
          "type": "number",
          "default": 20000,
          "minimum": 256,
          "description": "Maximum tool output characters rendered in VS Code surfaces before truncation."
        },
        "piRpc.maxImageBytes": {
          "type": "number",
          "default": 3145728,
          "minimum": 1024,
          "description": "Maximum accepted attachment size per image before local rejection."
        },
        "piRpc.maxImagesPerPrompt": {
          "type": "number",
          "default": 4,
          "minimum": 0,
          "description": "Maximum images attached to one prompt."
        },
        "piRpc.restartOnCrash": {
          "type": "boolean",
          "default": true,
          "description": "Automatically restart the owned Pi process after an unexpected exit."
        },
        "piRpc.maxRestartAttempts": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "Maximum automatic restart attempts after unexpected exits."
        },
        "piRpc.telemetryEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Reserved local extension telemetry switch. No telemetry is sent by default."
        },
        "piRpc.editorTabs.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Open Pi chats as native editor tabs backed by pi-chat: resources. Turn off only to roll back to the legacy shared panel during migration."
        },
        "piRpc.workingAnimation": {
          "type": "string",
          "enum": [
            "braille",
            "dots",
            "bars",
            "earth",
            "moon",
            "dolphin"
          ],
          "enumDescriptions": [
            "Braille spinner",
            "Bouncing dots",
            "Pulsing bars",
            "Spinning earth (emoji)",
            "Moon phases (emoji)",
            "Leaping dolphin (emoji)"
          ],
          "default": "braille",
          "description": "Animation shown while Pi is working."
        },
        "piRpc.chatFontFamily": {
          "type": "string",
          "default": "",
          "description": "Font family for chat text. Empty = editor font."
        },
        "piRpc.chatFontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 32,
          "description": "Chat text font size in px. 0 = default."
        },
        "piRpc.notifyOnComplete": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when Pi finishes a long response while the chat is not focused."
        },
        "piRpc.typewriterSpeed": {
          "type": "string",
          "enum": [
            "off",
            "slow",
            "normal",
            "fast"
          ],
          "enumDescriptions": [
            "No smoothing - show streamed text as it arrives",
            "Gentle typing",
            "Balanced typing (default)",
            "Quick typing"
          ],
          "default": "normal",
          "description": "How smoothly streamed answers type out. \"off\" shows Pi's coarse chunks directly."
        },
        "piRpc.autoCompact.mode": {
          "type": "string",
          "enum": [
            "auto",
            "off"
          ],
          "enumDescriptions": [
            "Auto-detect the current model's maximum context window and compact when usage reaches piRpc.autoCompact.percent of it.",
            "Never auto-compact from the extension (Pi still compacts when nearly full)."
          ],
          "default": "auto",
          "description": "Auto-compaction mode. 'auto' detects the current model's max tokens and compacts at the configured percent; 'off' disables it."
        },
        "piRpc.autoCompact.percent": {
          "type": "number",
          "default": 65,
          "minimum": 10,
          "maximum": 95,
          "description": "When mode is 'auto', compact once context usage reaches this percent of the current model's auto-detected maximum context window."
        },
        "piRpc.autoCompact.resumeTask": {
          "type": "boolean",
          "default": true,
          "description": "After an auto-compaction, automatically continue the in-progress task on the freshly compacted context."
        },
        "piRpc.autoCompactThreshold": {
          "type": "number",
          "default": 70,
          "minimum": 0,
          "maximum": 100,
          "deprecationMessage": "Deprecated. Use piRpc.autoCompact.mode and piRpc.autoCompact.percent instead.",
          "description": "Deprecated — replaced by piRpc.autoCompact.mode + piRpc.autoCompact.percent."
        },
        "piRpc.codeLensEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show an inline \"Ask Pi\" action above functions/methods in code files."
        },
        "piRpc.remote.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the Connect a phone feature (watch or drive a chat from your phone). Off by default; when off the Connect a phone button and the remote-session commands are hidden."
        },
        "piRpc.remote.brokerUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of the Pi remote broker (e.g. https://pi.fromlab.work or http://localhost:8000). Empty disables remote sessions."
        },
        "piRpc.remote.hostSecret": {
          "type": "string",
          "default": "",
          "markdownDescription": "Host secret used to open a remote session (matches the broker PI_YOURS_HOST_SECRET). Store it securely; source from the vault."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "piRpcInternal.openSettingsMenu",
          "when": "view == piRpc.sessions",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "piRpcInternal.openChat",
          "when": "resourceScheme == file || resourceScheme == untitled || resourceScheme == pi-chat",
          "group": "navigation@1"
        },
        {
          "command": "piRpc.newSession",
          "when": "resourceScheme == file || resourceScheme == untitled || resourceScheme == pi-chat",
          "group": "navigation@2"
        },
        {
          "submenu": "piRpc.chatActions",
          "when": "activeCustomEditorId == 'piRpc.chatEditor'",
          "group": "navigation@0"
        }
      ],
      "piRpc.chatActions": [
        {
          "command": "piRpc.renameSession",
          "group": "1_session@1"
        },
        {
          "command": "piRpcInternal.retryLast",
          "group": "1_session@2"
        },
        {
          "command": "piRpcInternal.retryWithModel",
          "group": "1_session@3"
        },
        {
          "command": "piRpc.showChatVersions",
          "group": "1_session@4"
        },
        {
          "command": "piRpcInternal.copyConversationMarkdown",
          "group": "2_export@1"
        },
        {
          "command": "piRpc.exportHtml",
          "group": "2_export@2"
        },
        {
          "command": "piRpc.setThinkingLevel",
          "group": "3_model@1"
        },
        {
          "command": "piRpc.compact",
          "group": "3_model@2"
        },
        {
          "command": "piRpc.reviewLastTurn",
          "group": "4_review@1"
        },
        {
          "command": "piRpcInternal.attachGitDiff",
          "group": "4b_attach@1"
        },
        {
          "command": "piRpcInternal.attachStagedDiff",
          "group": "4b_attach@2"
        },
        {
          "command": "piRpcInternal.attachTerminalSelection",
          "group": "4b_attach@3"
        },
        {
          "command": "piRpcInternal.restart",
          "group": "5_system@1"
        },
        {
          "command": "piRpcInternal.showHealth",
          "group": "5_system@2"
        },
        {
          "command": "piRpcInternal.showLogs",
          "group": "5_system@3"
        },
        {
          "command": "piRpcInternal.showHelp",
          "group": "5_system@4"
        }
      ],
      "commandPalette": [
        {
          "command": "piRpcInternal.deleteSession",
          "when": "false"
        },
        {
          "command": "piRpcInternal.renameSession",
          "when": "false"
        },
        {
          "command": "piRpc.remote.start",
          "when": "piRpc.remoteEnabled"
        },
        {
          "command": "piRpc.remote.stop",
          "when": "piRpc.remoteEnabled"
        },
        {
          "command": "piRpcInternal.openSettingsMenu",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "submenu": "piRpc.ask",
          "group": "navigation@99",
          "when": "editorHasSelection && editorLangId != 'log'"
        }
      ],
      "piRpc.ask": [
        {
          "command": "piRpc.explainSelection",
          "group": "1_ask@1"
        },
        {
          "command": "piRpc.fixSelection",
          "group": "1_ask@2"
        },
        {
          "command": "piRpc.refactorSelection",
          "group": "1_ask@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "piRpc.commandPalette",
        "key": "cmd+k",
        "mac": "cmd+k",
        "win": "ctrl+k",
        "linux": "ctrl+k",
        "when": "activeCustomEditorId == 'piRpc.chatEditor'"
      },
      {
        "command": "piRpc.quickSwitchChat",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      }
    ],
    "submenus": [
      {
        "id": "piRpc.ask",
        "label": "Ask Pi",
        "icon": "$(sparkle)"
      },
      {
        "id": "piRpc.chatActions",
        "label": "Pi Chat Actions",
        "icon": {
          "light": "media/tab-icon.svg",
          "dark": "media/tab-icon.svg"
        }
      }
    ]
  },
  "homepage": "https://github.com/mr-narender/Pi#readme",
  "bugs": {
    "url": "https://github.com/mr-narender/Pi/issues"
  }
}
