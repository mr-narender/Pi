# The extension ships as the esbuild bundle in dist/ + host/pi-multi-host.mjs.
# Pi itself is NOT vendored in the VSIX anymore: piSource='managed' (default)
# bootstraps the latest Pi into globalStorage on the client's first run. This
# keeps the VSIX ~1 MB / a few hundred files instead of 24 MB / 13k files.
# vendor/ exists only in dev checkouts (npm run vendor:pi) for F5 + tests.
vendor/**
.vscode/**
.github/**
src/**
test/**
scripts/**
docs/**
node_modules/**
*.vsix
tsconfig.json
test/tsconfig.json
eslint.config.mjs
.prettierrc
.prettierrc.json
.prettierignore
.editorconfig
.gitignore
.gitattributes
CLAUDE.md
package-lock.json
coverage/**
.tmp/**
*.log
**/.DS_Store
